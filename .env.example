# murchace configuration
# MURCHACE_DEBUG=true

# Receipt Printer Settings
# MURCHACE_RECEIPT_PRINTER_HOST=192.168.1.100
# MURCHACE_RECEIPT_PRINTER_PORT=9100
# MURCHACE_RECEIPT_PRINTER_TIMEOUT=10   # 接続タイムアウト秒数（デフォルト: 10）
# MURCHACE_RECEIPT_PAPER_WIDTH=34       # 用紙幅（半角文字数、58mm紙=34、80mm紙=48相当）

# Receipt Store Information
# MURCHACE_RECEIPT_STORE_NAME=murchace
# MURCHACE_RECEIPT_STORE_ADDRESS=愛知県豊橋市天伯町字雲雀ヶ丘1-1
# MURCHACE_RECEIPT_LOGO_PATH=static/favicon.ico
